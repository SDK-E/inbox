{
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "moduleResolution": "bundler",
    "lib": ["dom", "dom.iterable", "es2024"],
    "module": "esnext",
    "target": "es2022",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "plugins": [
      {
        "name": "tsconfig-paths"
      },
      {
        "name": "next"
      }
    ],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "lib/**/*",
    "app/**/*",
    "scripts/**/*",
    "tests/**/*",
    "eslint.config.mjs",
    "drizzle.config.ts",
    "next.config.ts",
    "vitest.config.ts",
    "*.config.mjs",
    "*.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
