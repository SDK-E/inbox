{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-output.md",
    "style": "markdown",
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "topFilesLength": 20,
    "showLineNumbers": true,
    "headerText": "Repository snapshot for agent readability. Generated by scripts/snapshot.ts.",
    "includeEmptyDirectories": false
  },
  "include": [
    "app/**",
    "lib/**",
    "scripts/**",
    "tests/**",
    "drizzle/**",
    "docs/**",
    "public/**",
    "*.ts",
    "*.tsx",
    "*.mjs",
    "*.json",
    "*.md",
    ".env.example",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      ".next/**",
      "out/**",
      "build/**",
      "dist/**",
      "coverage/**",
      "test-results/**",
      "playwright-report/**",
      "node_modules/**",
      "repomix-output.md",
      "tsconfig.tsbuildinfo",
      "*.tsbuildinfo",
      "next-env.d.ts",
      ".agents/**",
      ".claude/**",
      ".kilocode/**",
      ".kiro/**",
      ".kilo/**",
      ".qwen/**",
      "skills-lock.json",
      ".env",
      ".env.*",
      ".vercel/**",
      "drizzle/migrations/.tmp/**"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
