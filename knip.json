{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignore": [
    ".agents/**",
    ".claude/**",
    ".kilocode/**",
    ".kiro/**",
    ".kilo/**",
    ".qwen/**",
    "docs/**"
  ],
  "ignoreDependencies": ["repomix"],
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": false,
  "next": true,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "exports": "error",
    "types": "error",
    "nsExports": "off",
    "nsTypes": "off",
    "duplicates": "off",
    "unlisted": "off"
  }
}
