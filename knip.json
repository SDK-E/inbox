{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignore": [
    ".agents/**",
    ".claude/**",
    ".kilocode/**",
    ".kiro/**",
    ".kilo/**",
    ".qwen/**",
    "packages/config/eslint/eslint.config.mjs",
    "packages/config/prettier.config.mjs"
  ],
  "ignoreBinaries": ["next"],
  "ignoreDependencies": [
    "repomix",
    "dependency-cruiser",
    "tsx",
    "@eslint/eslintrc",
    "eslint-config-next"
  ],
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": false,
  "next": true,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "exports": "error",
    "types": "error",
    "nsExports": "off",
    "nsTypes": "off",
    "duplicates": "off",
    "unlisted": "off"
  }
}
